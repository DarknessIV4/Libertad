     setAutoUpdate: (on: boolean) => ipcRenderer.invoke('system:setAutoUpdate', !!on),
+    setThrottleWhenHidden: (on: boolean) => ipcRenderer.invoke('system:setThrottleWhenHidden', !!on),
     relaunch: () => ipcRenderer.invoke('system:relaunch'),
